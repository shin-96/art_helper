# Copy this file to .env and add ONE AI key. With no key at all, the app
# still works with its local analysis and the demonstration lesson.
#
# FREE options (no credit card):
#   GEMINI_API_KEY      Google AI Studio - https://aistudio.google.com/apikey
#                       Free tier, vision included (default model gemini-2.5-flash).
#   OPENROUTER_API_KEY  OpenRouter - https://openrouter.ai/keys
#                       Free :free models (default google/gemma-4-31b-it:free).
#   GROQ_API_KEY        Groq - https://console.groq.com/keys
#                       Free tier (default model meta-llama/llama-4-scout-17b-16e-instruct).
#
# Paid option:
#   OPENAI_API_KEY      OpenAI (default model gpt-4.1-mini).
#
# Priority when several keys exist: Gemini > OpenRouter > Groq > OpenAI.
# Force any OpenAI-compatible endpoint/model with AI_API_KEY / AI_BASE_URL / AI_MODEL.
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

PORT=3001
OPENAI_TIMEOUT_MS=90000
